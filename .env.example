# Copy to .env (gitignored) and fill in. docker compose and scripts/replay_downloader.py both read it.

# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Optional. Without it, OpenDota allows 60 calls a minute and 3,000 a day.
OPENDOTA_API_KEY=

# rclone destination for scripts/replay_downloader.py
DRIVE_DEST=Google Drive:dota-pipeline/raw
