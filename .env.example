# Copy to .env (gitignored) and fill in. docker compose and scripts/downloader.py both read it.

# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Optional, and billed: with a key, every OpenDota call costs about US$0.0001, charged monthly.
# Leave blank to use the free tier (60 calls a minute, 3,000 a day, no charges).
OPENDOTA_API_KEY=
# Hard cap on OpenDota calls per day, keyed or not. 3000 calls is about US$0.30 a day with a key.
OPENDOTA_DAILY_CAP=3000

# rclone destination for scripts/downloader.py
DRIVE_DEST=Google Drive:dota-pipeline/raw
