<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd job for one route of scripts/downloader.py (steam or replays). It runs every
  hour while the Mac is awake; each run stops after 55 minutes, and a lock file stops overlaps.

  Install both routes from the repo root. Each starts a first run at once:
    mkdir -p ~/.local/share/dota-pipeline/logs
    for route in steam replays; do
      sed -e "s|__REPO__|$PWD|g" -e "s|__HOME__|$HOME|g" -e "s|__ROUTE__|$route|g" \
        scripts/launchd/dota-downloader.plist.template > ~/Library/LaunchAgents/dota-$route.plist
      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dota-$route.plist
    done

  Stop:
    launchctl bootout gui/$(id -u)/dota-steam
    launchctl bootout gui/$(id -u)/dota-replays
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dota-__ROUTE__</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>/opt/homebrew/bin/python3</string>
        <string>__REPO__/scripts/downloader.py</string>
        <string>__ROUTE__</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/.local/share/dota-pipeline/logs/launchd-__ROUTE__.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/share/dota-pipeline/logs/launchd-__ROUTE__.err.log</string>
</dict>
</plist>
