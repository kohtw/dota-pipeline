<?xml version="1.0" encoding="UTF-8"?>
<!--
  macOS launchd job: runs scripts/replay_downloader.py every hour while the Mac is awake.
  Each run stops after 55 minutes, so runs never overlap (a lock file also guards this).

  Install from the repo root. This replaces __REPO__ and __HOME__, and starts a first run at once:
    mkdir -p ~/.local/share/dota-pipeline/logs
    sed -e "s|__REPO__|$PWD|g" -e "s|__HOME__|$HOME|g" scripts/launchd/dota-replay-downloader.plist \
      > ~/Library/LaunchAgents/dota-replay-downloader.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dota-replay-downloader.plist

  Stop:
    launchctl bootout gui/$(id -u)/dota-replay-downloader
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dota-replay-downloader</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>/opt/homebrew/bin/python3</string>
        <string>__REPO__/scripts/replay_downloader.py</string>
        <string>run</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/.local/share/dota-pipeline/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/share/dota-pipeline/logs/launchd.err.log</string>
</dict>
</plist>
